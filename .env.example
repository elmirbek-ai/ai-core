# AI Core client authentication
AI_CORE_AUTH_ENABLED=true
AI_CORE_API_KEY=

# Inbound rate limiting (process-local)
AI_CORE_RATE_LIMIT_ENABLED=true
AI_CORE_REQUESTS_PER_MINUTE=60
AI_CORE_BURST_SIZE=10
AI_CORE_MAX_STREAMS=4

# Groq (required default primary)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# Provider routing
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=openrouter

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SUPPORTS_IMAGES=false
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2

# OpenAI direct: REJECTED (zero-cost gate). Archived adapter only; do not enable.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_SUPPORTS_IMAGES=false

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# Cloudflare Workers AI (optional; token and account ID are both required)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=cf/openai/gpt-oss-120b
CLOUDFLARE_TIMEOUT_SECONDS=30
CLOUDFLARE_MAX_RETRIES=2
# Set true only after verifying Free account + selected free-allocation model,
# no payment method requirement, and quota exhaustion cannot incur charges.
CLOUDFLARE_ZERO_COST_VERIFIED=false

# Ollama Cloud: NOT VERIFIED for permanent zero-cost; registry blocks its use.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=2

# Kilo anonymous gateway (optional and explicit opt-in)
# Historical defaults below are NOT VERIFIED and blocked by the zero-cost gate.
# kilo-auto/free is supported; set all three models explicitly after review.
KILO_ENABLED=false
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_GENERAL_MODEL=stepfun/step-3.7-flash:free
KILO_CODE_MODEL=cohere/north-mini-code:free
KILO_LONG_CONTEXT_MODEL=dots-studio/dots-3-note-preview:free
KILO_TIMEOUT_SECONDS=60
KILO_MAX_RETRIES=1

# LLM7 (optional and explicit opt-in)
LLM7_ENABLED=false
LLM7_API_KEY=
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_GENERAL_MODEL=gpt-oss:20b
LLM7_REASONING_MODEL=gpt-oss:20b
LLM7_CODE_MODEL=gpt-oss:20b
LLM7_TIMEOUT_SECONDS=60
LLM7_MAX_RETRIES=1
# Set true only after verifying non-billable free account/model/quota exhaustion.
LLM7_ZERO_COST_VERIFIED=false

# Provider circuit breaker
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# Task request budgets
LLM_REQUEST_BUDGET_ENABLED=true
LLM_STANDARD_BUDGET_SECONDS=30
LLM_REASONING_BUDGET_SECONDS=60
LLM_CODE_BUDGET_SECONDS=60
LLM_LONG_CONTEXT_BUDGET_SECONDS=90
LLM_MULTIMODAL_BUDGET_SECONDS=90

# Process-local telemetry
LLM_TELEMETRY_ENABLED=true

# Provider concurrency bulkheads
LLM_PROVIDER_CONCURRENCY_ENABLED=true
LLM_PROVIDER_DEFAULT_MAX_CONCURRENCY=4
LLM_GROQ_MAX_CONCURRENCY=4
LLM_OPENROUTER_MAX_CONCURRENCY=2
LLM_GEMINI_MAX_CONCURRENCY=3
LLM_CLOUDFLARE_MAX_CONCURRENCY=3
LLM_OLLAMA_MAX_CONCURRENCY=2
LLM_KILO_MAX_CONCURRENCY=1
LLM_LLM7_MAX_CONCURRENCY=1

# Deterministic AUTO task detection
LLM_AUTO_LONG_CONTEXT_CHARS=12000
